<Window x:Class="FolderIconStudio.QuickApplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置文件夹图标"
        Width="640" Height="545"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F5F7"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Foreground="#1F2937"
        Icon="app-icon.ico">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="选择一个图标" FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="FolderPathText" Foreground="#6B7280" FontSize="12"
                       TextWrapping="Wrap" MaxHeight="40" Margin="0,6,0,0" />
            <TextBlock Text="图标会写入这个文件夹内部，以后重装系统或换电脑仍然有效。"
                       Foreground="#98A1AE" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10"
                BorderBrush="#E5E8ED" BorderThickness="1" Margin="0,12,0,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="导入图标 / 图片"
                            Style="{StaticResource SoftButton}" Padding="10,5" Click="Import_Click" />
                    <ComboBox x:Name="LibraryPicker" DockPanel.Dock="Left" Width="190" Height="28"
                              VerticalContentAlignment="Center" Padding="6,0"
                              DisplayMemberPath="Name"
                              SelectionChanged="LibraryPicker_SelectionChanged" />
                    <TextBlock x:Name="LibraryCountText" Foreground="#8A93A2" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <Grid Grid.Row="1">
                    <ListBox x:Name="IconList"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource IconItemStyle}"
                             ItemTemplate="{StaticResource IconTemplate}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock x:Name="EmptyLibraryText"
                               Text="图标库为空&#10;点击右上角「导入图标 / 图片」添加"
                               Foreground="#A0A7B4" TextAlignment="Center" LineHeight="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="RestoreButton" Content="恢复默认图标"
                        Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="Restore_Click" />
                <Button Content="取消" Style="{StaticResource SoftButton}"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="ApplyButton" Content="应用图标"
                        Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="#6B7280" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
